{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vastra-Gotalandsregionen/app-features/schema/feature_flags.schema.json",
  "title": "App feature flags",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "flags"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "programme": { "$ref": "#/$defs/programme" },
    "flags": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/flag" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "programme": {
      "description": "Heading and intro text for the 'VGR testar' page that lists the user flags.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "intro"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string", "minLength": 1 }
      }
    },
    "icon": {
      "description": "Icon shown on the test's list row. If omitted, the app shows a default icon.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ios", "android"],
      "properties": {
        "ios": { "description": "SF Symbol name (systemImage).", "type": "string", "minLength": 1 },
        "android": { "description": "Name of an icon from Android's built-in icon library.", "type": "string", "minLength": 1 }
      }
    },
    "flag": {
      "oneOf": [
        { "$ref": "#/$defs/userFlag" },
        { "$ref": "#/$defs/remoteFlag" }
      ]
    },
    "userFlag": {
      "description": "A test listed under 'VGR testar', with a list row and a simple detail page. The user toggles it on or off.",
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "status", "defaultEnabled", "title", "minAppVersion"],
      "properties": {
        "control": { "const": "user" },
        "status": {
          "description": "active: ongoing test. ended: finished test that is still shown but always off. hidden: not shown at all.",
          "enum": ["active", "ended", "hidden"]
        },
        "defaultEnabled": { "type": "boolean" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "icon": { "$ref": "#/$defs/icon" },
        "version": {
          "description": "The test's own version, shown as a label (e.g. \"1.0\", \"2.0\"). Not the app version.",
          "type": "string",
          "minLength": 1
        },
        "sortOrder": {
          "description": "Position in the list; lower comes first.",
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "description": "Plain text for the detail page. A blank line (\\n\\n) starts a new paragraph. No markdown.",
          "type": "string"
        },
        "acknowledgement": {
          "description": "Text the user must confirm the first time they switch the test on.",
          "type": "string",
          "minLength": 1
        },
        "minAppVersion": { "$ref": "#/$defs/version" }
      }
    },
    "remoteFlag": {
      "description": "Never shown to the user; controlled only via 'enabled'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "enabled", "minAppVersion"],
      "properties": {
        "control": { "const": "remote" },
        "enabled": { "type": "boolean" },
        "minAppVersion": { "$ref": "#/$defs/version" }
      }
    }
  }
}
